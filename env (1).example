# ─────────────────────────────────────────────────────────────────────
# Video Subtitle Generator —— 环境变量配置
# 复制本文件为 .env，按需修改
# 服务启动时自动加载（python-dotenv），改完重启生效
# ─────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════
# 必填：API Keys
# ═══════════════════════════════════════════

# Gemini API（字幕翻译 + Slide Vision 必用）
GOOGLE_API_KEY=your-gemini-api-key-here

# 可选：Fish Audio（用 Fish TTS 时填）
FISH_API_KEY=

# 可选：OpenAI（用 OpenAI TTS 时填）
OPENAI_API_KEY=

# 可选：服务鉴权 token（留空 = 不鉴权，局域网用足够）
AUTH_TOKEN=


# ═══════════════════════════════════════════
# 服务端口
# ═══════════════════════════════════════════
PORT=28500


# ═══════════════════════════════════════════
# Whisper 本地转录
# ═══════════════════════════════════════════

# 总开关。设 0 强制走旧的 Gemini-视频流程
WHISPER_ENABLED=1

# 模型：tiny / base / small / medium / large-v3-turbo / large-v3
# 3080 10GB 跑 large-v3-turbo 最佳，质量速度兼顾
WHISPER_MODEL_SIZE=large-v3-turbo

# cuda / cpu。cpu 极慢，仅 GPU 不可用时备用
WHISPER_DEVICE=cuda

# float16（默认）/ int8（显存紧张时用，质量略降）
WHISPER_COMPUTE_TYPE=float16

# 启动时预加载模型，避免首请求等 5-15s。强烈推荐打开
WHISPER_PREWARM=1

# 是否让 Whisper 用前段上下文（True = 段落边界更对齐句子，
# False = 减少末尾幻觉但可能切坏句子）。我们已有 duration clamp，开着安全
WHISPER_CONDITION_ON_PREV=1

# VAD 静音判定阈值（毫秒）。越大越不容易在呼吸/换气小停顿处切段
# 500 是平衡值；调到 700-1000 段更完整但可能合并不该合的句
WHISPER_VAD_MIN_SILENCE_MS=500


# ═══════════════════════════════════════════
# Gemini 翻译模型
# ═══════════════════════════════════════════

# Thinking 模式深度（仅 Gemini 3.x 生效）
# minimal: 几乎不思考，最快（事实/分类类任务）
# low:     轻量推理（适合简单编辑/翻译）
# medium:  平衡（Gemini 默认）
# high:    深度推理（最聪明，TTFT 多 10-15s）—— 当前默认，质量优先
GEMINI_THINKING_LEVEL=high


# ═══════════════════════════════════════════
# Whisper 幻觉过滤（视频末尾防胡言乱语）
# ═══════════════════════════════════════════

# no_speech 阈值。越大越严格地把"几乎没声音"的段当成静音丢掉
# 默认 0.7（比 Whisper 原生 0.6 严）。若你视频音量小，调到 0.6
WHISPER_NO_SPEECH_THRESHOLD=0.7

# log_prob 阈值。越大（往 0 靠）越严格地拒绝低置信度转录
# 默认 -0.8（比 Whisper 原生 -1.0 严）。乱码/幻觉段大多落在这个区间
WHISPER_LOG_PROB_THRESHOLD=-0.8


# ═══════════════════════════════════════════
# TTS 配音节奏（Edge TTS / MeloTTS 生效）
# ═══════════════════════════════════════════

# 每段语音填充槽位的目标比例
# 0.85 = 平衡；0.75 = 更松弛、停顿多；0.9 = 更紧凑
TTS_TARGET_FILL=0.85

# 最低语速倍率。1.0 = 不让 TTS 比自然更慢（避免拖音）
TTS_MIN_SPEED=1.0

# 最高语速倍率。1.3 = 紧凑段最多加速 30%
# 调到 1.5 能塞更多字但听感会"急"
TTS_MAX_SPEED=1.3


# ═══════════════════════════════════════════
# 杂项 / 静默警告
# ═══════════════════════════════════════════

# 消掉 HuggingFace 在 Windows 上的符号链接 warning
HF_HUB_DISABLE_SYMLINKS_WARNING=1
