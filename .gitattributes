# Default: detect & normalize to LF in repo, native on checkout
* text=auto

# Force LF for shell / python / web (used on WSL Linux, breaks if CRLF)
*.sh        text eol=lf
*.py        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
.env*       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Force CRLF for Windows-only scripts
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary — don't try to diff or convert line endings
*.mp3       binary
*.mp4       binary
*.wav       binary
*.mov       binary
*.mkv       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.pdf       binary
*.zip       binary
*.gz        binary
